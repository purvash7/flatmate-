# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where FlatMate+ is hosted.
APP_URL="https://YOUR-SERVICE.onrender.com"

# Render PostgreSQL connection string. Use the Internal Database URL on Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Google OAuth Client ID for Google Sign-In.
# Authorized redirect URI used by the current popup flow:
# https://YOUR-SERVICE.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=""

# JWT Secret for session tokens. Replace this with a long random value in Render.
JWT_SECRET="replace-with-a-long-random-secret"

# Development Data Seeding (true to seed Bangalore demo profiles).
SEED_DUMMY_DATA="true"
