# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where FlatMate+ is hosted.
APP_URL="http://localhost:3000"

# Render PostgreSQL connection string. Use the Internal Database URL on Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Twilio Verify for Indian SMS OTP (optional in dev).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Google OAuth Client ID for Google Identity Services.
GOOGLE_CLIENT_ID=""

# JWT Secret for session tokens.
JWT_SECRET="flatmate_plus_secure_jwt_secret_key_2026"

# Development Data Seeding (true to seed 10+ Bangalore profiles).
SEED_DUMMY_DATA="true"
